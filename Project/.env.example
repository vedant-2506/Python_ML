# Copy to Backend/.env for local development and replace every placeholder.
ENV=dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rankresume
DB_USER=root
DB_PASSWORD=replace-with-local-password
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=480
FRONTEND_ORIGIN=http://localhost:5500
FRONTEND_BASE_URL=http://localhost:5500
EXAM_LINK_EXPIRY_HOURS=72
SEND_EXAM_EMAILS=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=
